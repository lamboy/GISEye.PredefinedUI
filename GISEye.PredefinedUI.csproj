<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>IL2057;IL2026;IL2104;IL3053</NoWarn>
    <RootNamespace>GISEye.PredefinedUI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-798" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    GISEye.Core 引用解析（按优先级）：
    1. 被 GISEye 子树同步复制进 src/GISEye.PredefinedUI 时，Core 是兄弟项目（CI 路径，保持不变）；
    2. 独立检出但本机有 GISEye 源码时，用 $(GISEyeRoot)\src\GISEye.Core（可经环境变量 GISEyeRoot 覆盖）；
    3. 两者都没有时回退到 NuGet 包，保证 clone 后可直接 build/test。
  -->
  <PropertyGroup>
    <GISEyeRoot Condition="'$(GISEyeRoot)' == ''">$(MSBuildThisFileDirectory)..\GISEye</GISEyeRoot>
    <_GISEyeCoreSubtreePath>$(MSBuildThisFileDirectory)..\GISEye.Core\GISEye.Core.csproj</_GISEyeCoreSubtreePath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_GISEyeCoreSubtreePath)')">
    <ProjectReference Include="$(_GISEyeCoreSubtreePath)" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(_GISEyeCoreSubtreePath)') and Exists('$(GISEyeRoot)\src\GISEye.Core\GISEye.Core.csproj')">
    <ProjectReference Include="$(GISEyeRoot)\src\GISEye.Core\GISEye.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(_GISEyeCoreSubtreePath)') and !Exists('$(GISEyeRoot)\src\GISEye.Core\GISEye.Core.csproj')">
    <!-- 浮动版本 "*"：restore 时取 NuGet 上的最新稳定版（"*-*" 则包含预发行版）。
         仅在回退模式下生效；子树/本地源码构建走 ProjectReference，不参与解析。 -->
    <PackageReference Include="GISEye.Core" Version="*" />
  </ItemGroup>

</Project>
